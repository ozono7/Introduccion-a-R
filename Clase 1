# --------------------------------------------------------------------------
# 3. Funciones en R
# --------------------------------------------------------------------------
elevado_al_cuadrado <- function(numero) {
  return(numero^2)
}

resultado <- elevado_al_cuadrado(4)  # Llamamos la función con el número 4
print(resultado)  # 16

# --------------------------------------------------------------------------
# 4. Ejercicios de conversión de unidades y humedad
# --------------------------------------------------------------------------

# 4.1. Convertir temperatura de Celsius a Kelvin
celsius_a_kelvin <- function(celsius) {
  return(celsius + 273.15)
}
print(celsius_a_kelvin(25))  # Convertimos 25°C a Kelvin: 298.15 K

# 4.2. Cálculo de humedad absoluta (aproximación simple)
# Presión de vapor en kPa, temperatura en °C; el resultado es la humedad
# absoluta en g/m^3.
humedad_absoluta <- function(presion_vapor, temperatura) {
  return((2167 * presion_vapor) / (temperatura + 273.15))
}
print(humedad_absoluta(2.3, 25))  # Ejemplo con P_v = 2.3 kPa y T = 25°C: 16.72 g/m^3

# 4.3. Conversión de presión de kPa a atm
kpa_a_atm <- function(presion_kpa) {
  return(presion_kpa / 101.325)
}
print(kpa_a_atm(101.325))  # 101.325 kPa = 1 atm

# 4.4. Calcular la humedad relativa (HR en porcentaje)
# Presión de vapor y presión de saturación en las mismas unidades (kPa).
humedad_relativa <- function(presion_vapor, presion_saturacion) {
  return((presion_vapor / presion_saturacion) * 100)
}
# Presión de saturación del agua a 25 °C: 3.17 kPa (tablas de vapor,
# Cengel, Thermodynamics, tabla A-4: 3.1698 kPa; la ecuación de Antoine
# da 3.16 kPa). Con P_v = 2.3 kPa, la humedad relativa es 72.6 %.
print(humedad_relativa(2.3, 3.17))  # Ejemplo con valores en kPa: 72.6 %

# --------------------------------------------------------------------------
# 5. Flujo laminar y turbulento, Número de Reynolds
# --------------------------------------------------------------------------

# Cálculo del Número de Reynolds
numero_reynolds <- function(densidad, velocidad, diametro, viscosidad) {
  return((densidad * velocidad * diametro) / viscosidad)
}

# Determinar tipo de flujo basado en el Número de Reynolds
tipo_flujo <- function(re) {
  if (re < 2000) {
    return("Flujo Laminar")
  } else if (re >= 2000 && re <= 4000) {
    return("Flujo Transicional")
  } else {
    return("Flujo Turbulento")
  }
}

# Ejemplo de cálculo del Número de Reynolds y tipo de flujo
densidad <- 1000  # kg/m^3 (ejemplo para agua)
velocidad <- 2  # m/s
diametro <- 0.05  # m
viscosidad <- 0.001  # Pa.s (para agua a 20°C)

re <- numero_reynolds(densidad, velocidad, diametro, viscosidad)
print(paste("Número de Reynolds:", re))  # 100000
print(paste("Tipo de flujo:", tipo_flujo(re)))  # Flujo Turbulento

